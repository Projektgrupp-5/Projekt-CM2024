  44:../../firmware/debugger/lib/usbcdc/src/drv_usb_core.c **** static void usb_core_reset (usb_core_regs *usb_regs)
  45:../../firmware/debugger/lib/usbcdc/src/drv_usb_core.c **** {
  46:../../firmware/debugger/lib/usbcdc/src/drv_usb_core.c ****     /* enable core soft reset */
  47:../../firmware/debugger/lib/usbcdc/src/drv_usb_core.c ****     usb_regs->gr->GRSTCTL |= GRSTCTL_CSRST;
  48:../../firmware/debugger/lib/usbcdc/src/drv_usb_core.c **** 
  49:../../firmware/debugger/lib/usbcdc/src/drv_usb_core.c ****     /* wait for the core to be soft reset */
  50:../../firmware/debugger/lib/usbcdc/src/drv_usb_core.c ****     while (usb_regs->gr->GRSTCTL & GRSTCTL_CSRST);
  51:../../firmware/debugger/lib/usbcdc/src/drv_usb_core.c **** 
  52:../../firmware/debugger/lib/usbcdc/src/drv_usb_core.c ****     /* wait for addtional 3 PHY clocks */
  53:../../firmware/debugger/lib/usbcdc/src/drv_usb_core.c ****     usb_udelay(3);
  54:../../firmware/debugger/lib/usbcdc/src/drv_usb_core.c **** }
