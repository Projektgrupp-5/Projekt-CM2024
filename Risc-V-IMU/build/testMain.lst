  14:testMain.c    **** #define SERVO_180_DEG     7500  // Pulsbredd för 180 grader (~2.5 ms) 
  15:testMain.c    **** // Tider (i millisekunder) 
  16:testMain.c    **** #define HALL_TIMEOUT_MS   1500  // Tid utan pulser innan vagnen anses stå still 
  17:testMain.c    **** #define RELEASE_WAIT_MS   5000  // Väntetid efter släppt handtag (5 sekunder) 
  18:testMain.c    **** #define BRAKE_DURATION_MS 30000 // Bromstid när servot är aktiverat (30 sekunder) 
  19:testMain.c    **** #define DEBOUNCE_MS       5     // Avstörning för hall-sensorn 
  20:testMain.c    **** #define LCD_REFRESH_MS    200   // Uppdatera skärmen 5 gånger per sekund (200 ms) 
