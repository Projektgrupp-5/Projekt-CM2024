  54:originall.c   **** // KONSTANTER OCH DEFINITIONER 
  55:originall.c   **** 
  56:originall.c   **** // ============================================================================ 
  57:originall.c   **** // Servovinklar (PA0 / TIMER1) 
  58:originall.c   **** 
  59:originall.c   **** #define SERVO_0_DEG       2000  // Pulsbredd för 0 grader (~0.67 ms) 
  60:originall.c   **** #define SERVO_180_DEG     7500  // Pulsbredd för 180 grader (~2.5 ms) 
  61:originall.c   **** // Tider (i millisekunder) 
  62:originall.c   **** #define HALL_TIMEOUT_MS   1500  // Tid utan pulser innan vagnen anses stå still 
  63:originall.c   **** #define RELEASE_WAIT_MS   5000  // Väntetid efter släppt handtag (5 sekunder) 
  64:originall.c   **** #define BRAKE_DURATION_MS 30000 // Bromstid när servot är aktiverat (30 sekunder) 
  65:originall.c   **** #define DEBOUNCE_MS       5     // Avstörning för hall-sensorn 
  66:originall.c   **** #define LCD_REFRESH_MS    200   // Uppdatera skärmen 5 gånger per sekund (200 ms) 
  67:originall.c   **** // Kapacitiv Touch-sensor (PB0 & PB1) 
  68:originall.c   **** #define TOUCH_THRESHOLD   70    // Tröskelvärde för grepp 
  69:originall.c   **** #define MAX_TIMEOUT       500000 // Säkerhetsgräns mot oändlig loop 
  70:originall.c   **** #define SAMPLES           16    // Antal mätningar för medelvärdesbildning 
  71:originall.c   **** // ============================================================================ 
  72:originall.c   **** // GLOBALA VARIABLER (volatile för avbrottshantering) 
  73:originall.c   **** // ============================================================================ 
  74:originall.c   **** 
  75:originall.c   **** volatile uint32_t ms_ticks = 0;           // Global millisekundräknare 
  76:originall.c   **** volatile uint32_t last_pulse_time = 0;    // Tidstämpel för senaste magnetpuls 
  77:originall.c   **** volatile uint32_t current_interval = 0;   // Tid mellan de två senaste magneterna 
  78:originall.c   **** volatile uint32_t previous_interval = 0;  // Tid mellan de näst senaste magneterna 
  79:originall.c   **** volatile uint8_t new_pulse_flag = 0;      // Flaggas vid ny godkänd magnet 
  80:originall.c   **** volatile uint8_t pulse_count = 0;         // Antal magneter sedan start/stopp 
  81:originall.c   **** 
  82:originall.c   **** // Systemets olika tillstånd (Tillståndsmaskin) 
  83:originall.c   **** 
  84:originall.c   **** typedef enum { 
  85:originall.c   ****     STATE_HELD,     // Någon håller i handtaget -> Servo 0° 
  86:originall.c   ****     STATE_WAITING,  // Handtag nyss släppt, väntar 5 sek -> Servo 0° 
  87:originall.c   ****     STATE_ARMED,    // 5 sek har gått, övervakar acceleration -> Servo 0° 
  88:originall.c   **** 
  89:originall.c   ****     STATE_BRAKED    // Broms aktiverad! -> Servo 180° i 30 sek 
  90:originall.c   **** 
  91:originall.c   **** } SystemState; 
